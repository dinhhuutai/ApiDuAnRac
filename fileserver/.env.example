# Cấu hình máy chủ tệp nội bộ NOIBO — chép thành file .env (cùng thư mục) rồi sửa.
# Hướng dẫn đầy đủ: README.md

# Cổng lắng nghe. 443 nếu máy chưa có web nào dùng cổng 443 (đường dẫn gọn), không thì 8443.
PORT=443
HOST=0.0.0.0

# Thư mục lưu tệp/ảnh (ổ dữ liệu, KHÔNG để ở ổ C:). Tự tạo nếu chưa có.
STORAGE_ROOT=D:\NOIBO_FILES

# Khoá bí mật dùng chung với API — PHẢI GIỐNG HỆT biến RQ_FILE_SECRET trong ApiDuAnRac/.env trên máy chủ API.
# Tạo khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_SECRET=

# Trang web được phép gọi vào (cách nhau bằng dấu phẩy)
ALLOWED_ORIGINS=https://noibo.thuanhunglongan.com,http://localhost:3001

# Dung lượng tối đa mỗi tệp (MB) — nên bằng RQ_FILE_MAX_MB của API
MAX_FILE_MB=50

# Chứng chỉ HTTPS (bắt buộc khi chạy thật — web là https nên trình duyệt chặn ảnh/tệp http).
# Cách 1: file .pfx (win-acme xuất ra)
HTTPS_PFX=C:\NOIBO\certs\files.thuanhunglongan.com.pfx
HTTPS_PFX_PASSPHRASE=
# Cách 2: cặp file PEM
# HTTPS_KEY=C:\NOIBO\certs\files-key.pem
# HTTPS_CERT=C:\NOIBO\certs\files-chain.pem
